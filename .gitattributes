# Markdown uses two trailing spaces for intentional hard line breaks.
*.md whitespace=-blank-at-eol

# Release archives are built from a fixed commit. Keep development, test, and
# legacy-reference material out of the installable WordPress plugin package.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/bin export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/CONTRIBUTING.md export-ignore
/docs export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpcs.xml.dist export-ignore
/phpunit.xml.dist export-ignore
/SECURITY.md export-ignore
/tests export-ignore
/tests-js export-ignore
